# ──────────────────────────────────────────────────────────────────────────
# Bungie application credentials
# Create an app at https://www.bungie.net/en/Application
#   • OAuth Client Type: Confidential
#   • Redirect URL:      https://localhost:4321/api/auth/callback
#   • Scope:             "Read your Destiny ... inventory and Vault"
# Then copy this file to `.env.local` and fill in the three values below.
# ──────────────────────────────────────────────────────────────────────────

# Server-only — the confidential OAuth credentials. NEVER prefix with NEXT_PUBLIC.
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# Server-only — signs the identity cookie. 32+ random bytes, different on every
# deployment: `openssl rand -base64 32`. Changing it re-confirms every session with
# Bungie once (nobody is signed out). Falls back to BUNGIE_CLIENT_SECRET when unset.
SESSION_SECRET=

# Sent as the X-API-Key header on every Bungie API call. The browser uses it too
# (for direct GetProfile / manifest calls later), so it is intentionally public.
NEXT_PUBLIC_BUNGIE_API_KEY=

# Base URL of this app — used to build the OAuth redirect URI (must match the
# value registered in the Bungie portal exactly).
NEXT_PUBLIC_APP_URL=https://localhost:4321

# ──────────────────────────────────────────────────────────────────────────
# Saved loadouts — Neon Postgres (free tier via the Vercel Marketplace).
# Server-only. The `loadouts` table is created automatically on first use.
# Without it, /api/loadouts answers 503 and the Loadouts page says storage
# isn't configured; everything else keeps working.
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────────────────
# Feedback — optional. Every bug or idea from the sidebar's "Send feedback" is
# saved in the `bug_reports` table (needs DATABASE_URL). Set this to a Discord
# webhook to also get each one posted to a channel: in a forum channel every
# report becomes its own post. Server-only — anyone with it can post there.
# ──────────────────────────────────────────────────────────────────────────
BUG_REPORT_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────
# Feedback tracker — optional, production only. Files feedback as issues in the
# private feedback repo and mirrors the Discord feedback forums (src/lib/feedback).
# Each route does nothing until its variables are set.
# ──────────────────────────────────────────────────────────────────────────
# Fine-grained token with Issues read/write on the feedback repo only.
FEEDBACK_GITHUB_TOKEN=
# owner/name; defaults to NoahHendrickson/d2-conflux-feedback.
FEEDBACK_GITHUB_REPO=
# Vercel sends it to the 10-minute forum sync.
CRON_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Verifies "Send to tracker" interactions.
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Comma-separated forum channel ids.
DISCORD_FEEDBACK_CHANNEL_IDS=
